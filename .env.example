# Copy to .env. Never commit credentials.
RPA_SOURCE=postgres
RPA_DATABASE_URL=postgresql://rpa_reader:CHANGE_ME@127.0.0.1:55439/puzzle_rpa
RPA_MODEL_ADAPTER=codex
RPA_MODEL=gpt-6.1-terra
RPA_REASONING=medium
RPA_MODEL_TIMEOUT=120
RPA_AGENT_MAX_STEPS=24
RPA_AGENT_TIMEOUT=900
RPA_CHAT_HISTORY=100
RPA_DASHBOARD_BRIEF_ENABLED=true
# agent: разбор в первом шаге ReAct; local: правила; model: отдельная классификация;
# decision: локальная нейронная Jev-style модель Kev; off: без разбора.
RPA_PREFLIGHT_MODE=agent
RPA_DECISION_URL=http://127.0.0.1:8009
RPA_DECISION_TIMEOUT=3
RPA_QUERY_TIMEOUT_MS=15000
RPA_ROW_LIMIT=500000
RPA_STORAGE=.local/state.sqlite3
RPA_HOST=127.0.0.1
RPA_PORT=8080
# Only for hosted HTTPS deployment; local loopback uses false.
RPA_SECURE_COOKIE=false
# Optional permanent HTTPS origin for MY.public:app (read-only snapshots only).
# Without it scripts/start_public.py provides a temporary address while running.
RPA_PUBLIC_BASE_URL=
RPA_PUBLIC_ADDRESS_FILE=.local/public-address.json
# Tunnel launcher options are process environment variables, not .env settings:
# RPA_TUNNEL_PROVIDER=ssh RPA_PUBLIC_PORT=8082 uv run python scripts/start_public.py
# Explicit demo: RPA_SOURCE=demo and RPA_MODEL_ADAPTER=demo (no model calls).

