# scripts/docker_start.sh creates a private .env.docker with generated passwords.
BI_DB_ADMIN_PASSWORD=CHANGE_ME
BI_DB_READER_PASSWORD=CHANGE_ME
BI_PORT=8080
BI_VIEW_PORT=8082
BI_BIND_ADDRESS=127.0.0.1
BI_PUBLIC_BASE_URL=http://127.0.0.1:8082
BI_MODEL_ADAPTER=codex
BI_MODEL=gpt-6.1-terra
BI_REASONING=medium
# First interactive installation offers a wizard. Change later:
# ./scripts/docker_start.sh --configure-model
# Never commit real keys. Model IDs must be available to your account.
BI_MODEL_BASE_URL=
BI_MODEL_API_KEY=
BI_MODEL_API_HEADERS={}
BI_MODEL_API_FORMAT=auto
BI_MODEL_API_REASONING=
BI_MODEL_MAX_OUTPUT_TOKENS=8192
BI_MODEL_TIMEOUT=120
BI_SECURE_COOKIE=false
BI_COMPOSE_PROJECT=bi-bot-dashboard
# Optional ZIP in ./data/puzzle-data.zip; otherwise the published fixture is downloaded.
BI_DATA_URL=https://nc.puzzle-rpa.ru/public.php/dav/files/gZaaDqjx2rcyfP4/?accept=zip
